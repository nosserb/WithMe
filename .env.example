NODE_ENV=development
PORT=3000
HTTPS_PORT=3443
APP_HOST=127.0.0.1

# Firestore config for /api/health/firestore
# Optional if project_id already exists in service-account JSON
FIREBASE_PROJECT_ID=your-project-id

# Option A: raw JSON service account content in one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Option B: absolute path to the service account json file
# Also accepted alias: GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
